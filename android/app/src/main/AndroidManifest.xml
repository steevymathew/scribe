<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECORD_AUDIO cannot be requested by an input method: an IME has no Activity to host
      the system dialog. It is granted in the app during onboarding, and the keyboard
      checks for it and offers a way back to the app when it is missing. See
      ScribeInputMethodService.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scribe">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Scribe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The keyboard. This is the primary text-injection surface: the system binds it,
          keeps it alive while a text field has focus, and never kills it for battery
          reasons. That is the entire architectural bet of this port.
        -->
        <service
            android:name=".ime.ScribeInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          Holds the microphone and the dictation state machine at process scope. The IME
          view is destroyed and recreated when the Fold opens or closes; state that lived
          in the view would be lost mid-sentence, so it lives here instead.
        -->
        <service
            android:name=".dictation.DictationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          Scribe as a system speech recogniser. This is what lets the microphone button on
          a keyboard you already use — Samsung Keyboard, Gboard, FUTO — send its request
          here and get text back, so dictating never means switching keyboards.
          Register it under Settings > General management > Keyboard list and default >
          Voice input.
        -->
        <service
            android:name=".voice.ScribeRecognitionService"
            android:exported="true"
            android:label="@string/voice_input_label"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!--
          The floating bubble. An accessibility service because only one can tell whether a
          text field has focus in another app, and only one can type into it. Off until the
          user turns it on.
        -->
        <service
            android:name=".bubble.ScribeAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
