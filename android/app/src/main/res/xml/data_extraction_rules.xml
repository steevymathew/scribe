<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing Scribe stores is eligible for cloud backup or device-to-device transfer.
  Transcript history, the custom dictionary and snippets are dictation content; they stay
  on the device that recorded them. Models are large and re-obtainable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
