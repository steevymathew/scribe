<?xml version="1.0" encoding="utf-8"?>
<!--
  The Scribe mark on a dark ground with the circle pressed into it. The artwork carries
  transparency, and on this product that transparency resolves to darkness rather than to
  white — the icon belongs to the same near-black surface as the rest of the app.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
