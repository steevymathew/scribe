#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv-npu"

if [ ! -d "$VENV_DIR" ]; then
    echo "Run ./setup.sh first to set up the NPU environment."
    exit 1
fi

source "$VENV_DIR/bin/activate"
exec python3 "$SCRIPT_DIR/scribe.py" --device npu --model small.en "$@"
